<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#030811"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="JARVIS NOTIFICATION BRIDGE"
            android:textColor="#BDF8FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="Give JARVIS Notification Access, then connect this phone to your JARVIS website."
            android:textColor="#A8C6CC"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/serverUrl"
            android:hint="Server URL, e.g. http://192.168.1.10:3000"
            android:textColor="#FFFFFF"
            android:hintTextColor="#668088"
            android:layout_marginTop="20dp"
            android:inputType="textUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/bridgeToken"
            android:hint="Bridge token"
            android:textColor="#FFFFFF"
            android:hintTextColor="#668088"
            android:inputType="textPassword"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/save"
            android:text="SAVE CONNECTION"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/access"
            android:text="OPEN NOTIFICATION ACCESS SETTINGS"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/test"
            android:text="TEST CONNECTION"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/status"
            android:text="Status: Not configured"
            android:textColor="#8FF3FF"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
